#!/usr/bin/env python3
from __future__ import annotations

# Microsoft To Do client for the Omarchy shell plugin (anishkn.mstodo).
#
# Why a CLI and not XMLHttpRequest inside QML: the OAuth refresh token is a
# long-lived credential that belongs in a 0600 file rather than in the shell's
# process state, the device-code login needs a polling loop with backoff, and
# the quick-add grammar is ordinary string parsing that is miserable to unit
# test in QML and trivial in Python. The shell only ever runs this binary and
# parses JSON.
#
# Auth is Microsoft's public device-code flow. The default tenant is /common;
# apps registered for personal accounts only are retried under /consumers and
# the choice is remembered. The bundled client id belongs to this plugin's
# own registered public app; if a tenant rejects it, register a free app
# (README) and put its id in OMARCHY_MSTODO_CLIENT_ID or auth.json's
# "client_id".
#
# All datetimes are sent as UTC instants ("timeZone": "UTC"); the cache stores
# epoch seconds so QML never parses ISO strings.

__doc__ = """Microsoft To Do client for the Omarchy shell plugin (anishkn.mstodo).

Commands:
  login                       authenticate via microsoft.com/link, then sync
  login start [--json]        request a device code; print it as JSON
  login poll [--json]         one poll against the pending sign-in
  login cancel                drop a pending sign-in
  logout                      forget tokens
  sync [--max-age SEC]        refresh the on-disk cache (skipped when fresh)
  status                      print the cache summary as JSON
  list [SCOPE] [-a] [--json]  list cached tasks (overdue|today|upcoming|all|done)
  add LINE                    create a task from the quick-add grammar
  update TASK_ID LINE         rewrite an existing task from the grammar
  complete TASK_ID            mark a task done (recurring -> next instance)
  uncomplete TASK_ID          reopen a completed task
  snooze TASK_ID WHEN         move due + reminder (@HH:MM, @tomorrow, ...)
  delete TASK_ID              delete a task
  settings [KEY [VALUE]]      show or set plugin settings (wraps omarchy bar set)
  read-bounded PATH MAX       read file with size limit & symlink protection (internal)
  seed-create PATH:JSON ...   create state files atomically if missing (internal)

TASK_ID accepts the short id suffix shown by `list` when it is unique.

Quick-add grammar (all parts optional, order free):
  TITLE @today|@tomorrow|@mon..@sun|@DD|@DD.MM [HH:MM]
        [repeat daily|weekdays|weekly|monthly|yearly|every N days|after-completion [until DD.MM]]
        [!low|!normal|!high]

Exit codes: 0 ok, 2 usage, 3 auth required, 4 network, 1 anything else.

Settings (via `omarchy-mstodo settings` or `omarchy bar set anishkn.mstodo`):
  persistentReminders   (bool)   default true  — critical urgency, never expires, bypasses DND
  syncInterval          (enum)   2 minutes | 5 minutes | 15 minutes | 1 hour | Only when opened
  notifyLeadMinutes     (enum)   At reminder time | 5 minutes before | 15 minutes before
  undoSeconds           (int)    0..30
  focusMinutes          (int)    1..180 (step 5)
  shortBreakMinutes     (int)    1..60
  longBreakMinutes      (int)    1..120 (step 5)
  longBreakInterval     (int)    1..12
  autoChain             (bool)   default true
  pomoNotifications     (bool)   default true
  maxTasksPerSection    (int)    3..30
  listName              (str)    exact display name of the To Do list to use
"""

import argparse
import fcntl
import json
import os
import re
import signal
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from contextlib import contextmanager
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

# --------------------------------------------------------------------------
# bounded file reads — protect against oversized / malicious state files
# and FIFO/special-file substitutions that could block the CLI indefinitely.
# Limits mirror the shell-side caps (Service.qml).
# --------------------------------------------------------------------------

READ_TIMEOUT_SECONDS = 5

# Per-file byte limits (must match Service.qml's head -c caps)
MAX_CACHE_BYTES = 256 * 1024      # data.json — 256 KiB
MAX_AUTH_BYTES = 16 * 1024        # auth.json — 16 KiB
MAX_LOGIN_BYTES = 16 * 1024       # login.json — 16 KiB
MAX_CONFIG_BYTES = 4 * 1024       # config.json — 4 KiB
MAX_MANIFEST_BYTES = 64 * 1024    # manifest.json — 64 KiB
MAX_SHELL_JSON_BYTES = 64 * 1024  # shell.json — 64 KiB


class FileReadTimeout(OSError):
    """Raised when a file read exceeds the timeout (likely FIFO/special file)."""
    pass


class FileReadLimitExceeded(ValueError):
    """Raised when a file exceeds its maximum allowed size."""
    pass


@contextmanager
def _read_timeout(seconds: int):
    """Signal-based timeout for blocking I/O operations (Unix only)."""
    def _handler(signum, frame):
        raise FileReadTimeout(f"read timed out after {seconds}s (possible FIFO/special file)")
    old_handler = signal.signal(signal.SIGALRM, _handler)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, old_handler)


def _read_file_bounded(path: str, max_bytes: int) -> str:
    """Read at most max_bytes from path with timeout; raise on timeout or limit exceeded.
    Opens file WITHOUT following symlinks (O_NOFOLLOW) and verifies it's a regular file.
    """
    try:
        with _read_timeout(READ_TIMEOUT_SECONDS):
            # Open WITHOUT following symlinks
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode):
                    raise FileReadLimitExceeded("not a regular file")
                with os.fdopen(fd, "rb") as fh:
                    data = fh.read(max_bytes + 1)
                    if len(data) > max_bytes:
                        raise FileReadLimitExceeded(f"file exceeds {max_bytes} bytes")
                    return data.decode("utf-8")
            finally:
                # os.fdopen takes ownership of fd and closes it on normal exit,
                # but if an exception occurs before fdopen, we need to close manually
                try:
                    os.close(fd)
                except OSError:
                    pass
    except FileReadTimeout:
        raise
    except OSError as e:
        if e.errno == 2:  # ENOENT
            raise
        if e.errno == 40:  # ELOOP - symlink detected
            raise FileReadLimitExceeded("symlinks not allowed")
        raise FileReadTimeout(f"read failed: {e}")


def cmd_read_bounded(args) -> int:
    """Read at most max_bytes from path with timeout; print to stdout on success.
    Exits non-zero with stderr message on error (matches other subcommand style)."""
    try:
        content = _read_file_bounded(args.path, args.max_bytes)
        sys.stdout.write(content)
        return 0
    except FileReadLimitExceeded as e:
        print(f"read-bounded: {e}", file=sys.stderr)
        return 1
    except FileReadTimeout as e:
        print(f"read-bounded: {e}", file=sys.stderr)
        return 1
    except OSError as e:
        if e.errno == 2:  # ENOENT
            print(f"read-bounded: file not found", file=sys.stderr)
        else:
            print(f"read-bounded: {e}", file=sys.stderr)
        return 1


def cmd_seed_create(args) -> int:
    """Create state files atomically if missing (notified.json, pomo.json).
    Uses O_CREAT|O_EXCL|O_NOFOLLOW to avoid TOCTOU races.
    Arguments are PATH:CONTENT pairs where CONTENT is JSON."""
    try:
        for item in args.files:
            # Split on first colon only, in case JSON content contains colons
            path, _, default_content = item.partition(":")
            if not path or not default_content:
                print(f"seed-create: invalid argument '{item}' (expected PATH:JSON)", file=sys.stderr)
                return 2
            # Validate that content is valid JSON
            try:
                json.loads(default_content)
            except json.JSONDecodeError:
                print(f"seed-create: invalid JSON content for {path}", file=sys.stderr)
                return 2
            # Ensure parent directory exists with 0700
            directory = os.path.dirname(path)
            os.makedirs(directory, mode=0o700, exist_ok=True)
            try:
                os.chmod(directory, 0o700, follow_symlinks=False)
            except Exception:
                try:
                    os.chmod(directory, 0o700)
                except OSError:
                    pass
            # Open with O_CREAT|O_EXCL|O_NOFOLLOW for atomic create-if-missing
            try:
                fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            except FileExistsError:
                continue  # already exists, no-op
            except OSError as e:
                if e.errno == 40:  # ELOOP - symlink detected
                    print(f"seed-create: {path}: symlinks not allowed", file=sys.stderr)
                    return 1
                raise
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as fh:
                    fh.write(default_content)
            finally:
                try:
                    os.close(fd)
                except OSError:
                    pass
        return 0
    except OSError as e:
        print(f"seed-create: {e}", file=sys.stderr)
        return 1


def load_json(path: str, fallback, *, max_bytes: int = MAX_CONFIG_BYTES):
    """Load JSON from a bounded, timeout-protected file read."""
    try:
        raw = _read_file_bounded(path, max_bytes)
        return json.loads(raw)
    except (OSError, ValueError, RecursionError, FileReadTimeout, FileReadLimitExceeded):
        return fallback


