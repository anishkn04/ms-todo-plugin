    global AUTH_BASE, _AUTHORITY
    _AUTHORITY = authority if authority in ("common", "consumers") else "common"
    AUTH_BASE = f"https://login.microsoftonline.com/{_AUTHORITY}/oauth2/v2.0"
SCOPES = "Tasks.ReadWrite User.Read offline_access"

